# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mist_siwes

# --- Firebase Admin (server-side only, never expose to the frontend) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: path to the service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: the JSON itself (useful on hosts without file mounts)
FIREBASE_CREDENTIALS_JSON=

# --- API ---
CORS_ORIGINS=http://localhost:3000
QR_TTL_SECONDS=45
LATE_AFTER_MINUTES=15
DEFAULT_RADIUS_METERS=100
MAX_GPS_ACCURACY_METERS=150
TIMEZONE=Africa/Lagos

# --- Storage ---
STORAGE_BACKEND=local            # local | s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Seed data (emails must match the accounts you will sign in with) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_INSTRUCTOR_EMAIL=instructor@example.com
SEED_SUPERVISOR_EMAIL=supervisor@example.com
# Optional existing Firebase student identity to link during demo seeding.
SEED_REAL_STUDENT_UID=
SEED_REAL_STUDENT_EMAIL=
SEED_REAL_STUDENT_NAME=
